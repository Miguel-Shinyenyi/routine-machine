# Copy this file to infra/.env and fill in real values. infra/.env is gitignored; never
# commit it.

# Base64 of an exported git-crypt key for the UMWAYI repo's journal/ paths. Lets the backend
# unlock a shallow clone to read the "Current book:" line from journal entries. Leave empty to
# disable hub-sync journal reading; the backend still starts without it. See docs/hub-sync.md.
UMWAYI_JOURNAL_KEY_B64=

# Optional GitHub token for the hub-sync and GitHub watering-hole fetches. Without one GitHub allows 60 requests an hour per
# IP address, shared by everything on it, and the syncs spend 4 requests a run (every 15 minutes and at every backend
# start), so a burst of restarts can use the quota up and both read "failing" until it resets. With one the limit is 5,000.
# Create a fine-grained personal access token with NO permissions and public repositories read-only (it only reads public
# data), at https://github.com/settings/personal-access-tokens. Leave empty to stay unauthenticated. Never commit it.
# See docs/hub-sync.md, "GitHub's rate limit".
GITHUB_TOKEN=

# WakaTime API key (from https://wakatime.com/settings/api-key). Lets the backend pull daily
# coding totals into the measurements table and, for any routine item sourced from WAKATIME, a
# daily_log. Leave empty to disable the WakaTime sync; the backend still starts without it.
# See docs/backend.md.
WAKATIME_API_KEY=

# Base URL of aw-server's local REST API (default http://localhost:5600 if unset). Unlike
# WakaTime and GitHub, ActivityWatch has no cloud component: this only works if the backend
# runs on the same machine as aw-server. See docs/backend.md's decisions log.
ACTIVITYWATCH_BASE_URL=

# RescueTime API key (from https://www.rescuetime.com/anapi/manage). Optional: even with a key
# set, the RescueTime sync stays off unless RESCUETIME_SYNC_ENABLED=true is also set, since
# PROJECT.md names this source as optional, unlike WakaTime/ActivityWatch/GitHub. See
# docs/backend.md.
RESCUETIME_API_KEY=
RESCUETIME_SYNC_ENABLED=

# Bearer token POST /api/measurements requires (Authorization: Bearer <token>) to accept a
# health-data measurement. Left empty, the endpoint rejects every request rather than
# accepting unauthenticated ones. Generate your own value; there is no default. See
# docs/backend.md.
HEALTH_INGEST_TOKEN=

# Anthropic API key (from https://console.anthropic.com), used by the intelligence service's
# POST /reading-notes/assess to assess reader's notes. Left empty, that endpoint returns 503
# rather than failing silently or guessing. See docs/intelligence-service.md.
ANTHROPIC_API_KEY=

# Phase 8 accounts: real password login now exists (/login, /register). AUTH_JWT_SECRET is a
# random string at least 32 characters long. Both the backend (which verifies it) and the
# frontend (which now mints it, see frontend/lib/auth/jwt.ts) need the exact same value — the
# backend will not start without it, and compose refuses to start without it. Generate one with
# `openssl rand -base64 48`. Never reuse a development value in production. AUTH_INTERNAL_TOKEN protects POST /api/auth/github-login, which
# trusts the caller already verified a GitHub identity; left empty, that endpoint rejects
# every request. See docs/backend.md.
AUTH_JWT_SECRET=
AUTH_INTERNAL_TOKEN=

# Access control: the email of the one account that gets the OWNER role and the pre-account data
# claim, and whose deployment integrations (WakaTime, hub-sync, ...) are connected. Name only here;
# put the real address in infra/.env, which git ignores. Left empty, nobody is the owner.
OWNER_EMAIL=

# Optional: what the reading-note assessment costs, so the metrics can estimate it. USD per million tokens, from
# your model's published pricing (check it yourself; no default is assumed). Left empty, the cost metric stays 0.
ANTHROPIC_INPUT_USD_PER_MTOK=
ANTHROPIC_OUTPUT_USD_PER_MTOK=

# Grafana (observability profile, http://localhost:3001): the admin password. Generate one, for example with
# `openssl rand -base64 24`; Grafana refuses to start without it, so it never runs on a default login.
GRAFANA_ADMIN_PASSWORD=

# Product analytics with PostHog (staged Prompt 5, docs/frontend.md "Analytics"). The project key and host come from Miguel's PostHog
# project settings. Leave both empty and analytics is off: no consent banner, no library loaded, no request to PostHog. With
# both set, a visitor is asked once, and nothing is sent unless they accept. Names only here; never commit the values.
POSTHOG_KEY=
POSTHOG_HOST=

# Who a visitor should contact to see, correct or delete their data (an email address or a web address). Shown on the public privacy page
# (/privacy). Optional: without it the page says to contact the person who runs the app. Never commit a real address here.
PRIVACY_CONTACT=

# Optional: the port Postgres is published on, on your machine. Default 5432. Set it (for example 5433) if something else
# already uses 5432; the services talk to Postgres inside Docker and are not affected. A connection from your own machine,
# such as a backend run outside Docker, needs ROUTINE_MACHINE_DB_URL to use the same port.
POSTGRES_HOST_PORT=
