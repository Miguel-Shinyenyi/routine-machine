# Copy this file to infra/.env and fill in real values. infra/.env is gitignored; never
# commit it.

# Base64 of an exported git-crypt key for the UMWAYI repo's journal/ paths. Lets the backend
# unlock a shallow clone to read the "Current book:" line from journal entries. Leave empty to
# disable hub-sync journal reading; the backend still starts without it. See docs/hub-sync.md.
UMWAYI_JOURNAL_KEY_B64=

# WakaTime API key (from https://wakatime.com/settings/api-key). Lets the backend pull daily
# coding totals into the measurements table and, for any routine item sourced from WAKATIME, a
# daily_log. Leave empty to disable the WakaTime sync; the backend still starts without it.
# See docs/backend.md.
WAKATIME_API_KEY=

# Base URL of aw-server's local REST API (default http://localhost:5600 if unset). Unlike
# WakaTime and GitHub, ActivityWatch has no cloud component: this only works if the backend
# runs on the same machine as aw-server. See docs/backend.md's decisions log.
ACTIVITYWATCH_BASE_URL=

# RescueTime API key (from https://www.rescuetime.com/anapi/manage). Optional: even with a key
# set, the RescueTime sync stays off unless RESCUETIME_SYNC_ENABLED=true is also set, since
# PROJECT.md names this source as optional, unlike WakaTime/ActivityWatch/GitHub. See
# docs/backend.md.
RESCUETIME_API_KEY=
RESCUETIME_SYNC_ENABLED=

# Bearer token POST /api/measurements requires (Authorization: Bearer <token>) to accept a
# health-data measurement. Left empty, the endpoint rejects every request rather than
# accepting unauthenticated ones. Generate your own value; there is no default. See
# docs/backend.md.
HEALTH_INGEST_TOKEN=

# Anthropic API key (from https://console.anthropic.com), used by the intelligence service's
# POST /reading-notes/assess to assess reader's notes. Left empty, that endpoint returns 503
# rather than failing silently or guessing. See docs/intelligence-service.md.
ANTHROPIC_API_KEY=

# Phase 8 accounts: real password login now exists (/login, /register). AUTH_JWT_SECRET is a
# random string at least 32 characters long. Both the backend (which verifies it) and the
# frontend (which now mints it, see frontend/lib/auth/jwt.ts) need the exact same value — the
# backend will not start without it. AUTH_INTERNAL_TOKEN protects POST /api/auth/github-login, which
# trusts the caller already verified a GitHub identity; left empty, that endpoint rejects
# every request. See docs/backend.md.
AUTH_JWT_SECRET=
AUTH_INTERNAL_TOKEN=
